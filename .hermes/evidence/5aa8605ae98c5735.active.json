    {
      "id": "01aced1b-c85c-5816-84de-4064888aa61d",
      "name": "Authenticate + Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const incoming=$input.first().json;const body=incoming.body||incoming;const headers=incoming.headers||{};const expected=$env.REPORT_PIPELINE_TOKEN;if(!expected)throw new Error('REPORT_PIPELINE_TOKEN is not configured');const auth=String(headers.authorization||headers.Authorization||'');if(auth!==`Bearer ${expected}`)throw new Error('Unauthorized');const allowed={\"natal\":\"01-natal\",\"relationship\":\"02-relationship-matrix\",\"loveblueprint\":\"03-love-blueprint\",\"lovetiming\":\"04-love-timing\",\"yearlytransit\":\"08-yearly-transit\",\"vocation\":\"09-vocation-wealth\",\"karmicshadow\":\"10-karmic-shadow\",\"fullcosmic\":\"11-full-cosmic-bundle\"};if(!allowed[body.reportType])throw new Error('Unsupported MVP reportType');if(!body.reportId||!body.verifiedFacts||!body.callbackUrl)throw new Error('Missing reportId, verifiedFacts, or callbackUrl');const m=String(body.callbackUrl).match(/^(https?):\\/\\/([^/:?#]+)(?::\\d+)?(?:[/?#]|$)/i);if(!m)throw new Error('callbackUrl is invalid');const protocol=m[1].toLowerCase(),hostname=m[2].toLowerCase();const configuredHosts=String($env.REPORT_CALLBACK_HOSTS||'').split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);const envHosts=[...new Set([...configuredHosts,'cosmicspiritguide.com','csg-next.onrender.com','csg-lb-staging-0905.onrender.com','localhost','127.0.0.1'])];const hostOK=envHosts.some(h=>hostname===h||hostname.endsWith('.'+h));if(!hostOK)throw new Error('callbackUrl host is not allowlisted');if(protocol!=='https'&&!['localhost','127.0.0.1'].includes(hostname))throw new Error('callbackUrl must use HTTPS');const compact=String($env.N8N_PREMIUM_NATAL_WORKFLOW||'').toLowerCase()==='compact'&&body.reportType==='natal'&&body.tier==='paid';return [{json:{...body,promptSlug:allowed[body.reportType],...(compact?{narrativeFactPacks:body.writerInput?.narrativeFactPacks,deterministic:body.writerInput?.deterministic}: {})}}];"
      }
    },
